PORT=3000

DB_PATH=data/tw2market.sqlite
DB_LOGGING=false
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

JWT_SECRET=
JWT_EXPIRES_IN=12h

# URL pública del frontend, usada para armar el enlace de recuperación
APP_URL=http://localhost:4200

# Correo saliente. Si SMTP_HOST queda vacío, los correos se guardan en data/buzon
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE=no-responder@tw2market.local
