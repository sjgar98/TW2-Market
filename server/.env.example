# Copiar a .env y completar. Ver la validación en src/config/env.validation.ts
NODE_ENV=development
PORT=3000

# Base de datos SQLite (better-sqlite3). El directorio se crea si no existe
DB_PATH=data/tw2market.sqlite
DB_LOGGING=false
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# JWT (JWT_SECRET: mínimo 32 caracteres, e.g. `openssl rand -base64 48`)
JWT_SECRET=
JWT_EXPIRES_IN=12h
